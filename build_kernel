    export NM=$tool/bin/llvm-nm
    export STRIP=$tool/bin/llvm-strip
    export OBJCOPY=$tool/bin/llvm-objcopy
    export OBJDUMP=$tool/bin/llvm-objdump
    export READELF=$tool/bin/llvm-readelf
    export HOSTAR=$tool/bin/llvm-ar
    export HOSTLD=$tool/bin/ld.lld
    export KCFLAGS="-fbasic-block-address-map"
    export CC_PROFILE="kernel_prop_cc_profile.txt"
    export LD_PROFILE="kernel_prop_ld_profile.txt"
    export PROP_PREFIX="kernel_prop"

    $CFG --enable AUTOFDO_CLANG
    $CFG --enable AUTOFDO_CLANG_STEPTWO
