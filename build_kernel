COMPILER="gcc" # ค่าเริ่มต้น
CLEAN=0

while [[ $# -gt 0 ]]; do
    case $1 in
        -c|--clean)
            CLEAN=1
            shift
            ;;
        -g|--gcc)
            COMPILER="gcc"
            shift
            ;;
        -l|--llvm|--clang)
            COMPILER="clang"
            shift
            ;;
        *)
            echo "[ERROR] พารามิเตอร์ไม่ถูกต้อง: $1"
            echo "วิธีใช้งาน: $0 [--clean] [--gcc | --clang]"
            exit 1
            ;;
    esac
done

if [[ $CLEAN -eq 1 ]]; then
    echo "[INFO] กำลังทำความสะอาด Build area..."
    make clean
    make mrproper
fi

tool="/home/tew404/kernel_build/llvm19.0.0"
mkdir -p ~/tmp_build
export TMPDIR=~/tmp_build
export PATH=$tool/bin:$PATH

# ==========================================
# 2. ตั้งค่าตัวแปร Compiler ตามที่ผู้ใช้เลือก
# ==========================================
if [[ "$COMPILER" == "clang" ]]; then
    # การตั้งค่าสำหรับ Clang / LLVM
    export LLVM=1
    export LLVM_IAS=1
    export CC=$tool/bin/clang
    export CXX=$tool/bin/clang++
    export HOSTCC=$tool/bin/clang
    export HOSTCXX=$tool/bin/clang++
    export LD=$tool/bin/ld.lld
    export AR=$tool/bin/llvm-ar
    export NM=$tool/bin/llvm-nm
    export STRIP=$tool/bin/llvm-strip
    export OBJCOPY=$tool/bin/llvm-objcopy
    export OBJDUMP=$tool/bin/llvm-objdump
    export READELF=$tool/bin/llvm-readelf
    export HOSTAR=$tool/bin/llvm-ar
    export HOSTLD=$tool/bin/ld.lld

    ACTIVE_BUILD="KDEB_NO_SOURCE_PACKAGE=1 NO_SOURCE=1 \
        KBUILD_NO_SYNC_CONFIG=1 KCONFIG_NOTIMESTAMP=1 \
        KCONFIG_OVERWRITECONFIG=1 \
        LLVM=1 LLVM_IAS=1 bindeb-pkg"
else
    # การตั้งค่าสำหรับ GCC-13
    unset LLVM
    unset LLVM_IAS
    export CC=$tool/bin/gcc-13
    export CXX=$tool/bin/g++-13
    export HOSTCC=$tool/bin/gcc-13
    export HOSTCXX=$tool/bin/g++-13
    export LD=$tool/bin/ld
    export AR=$tool/bin/ar
    export NM=$tool/bin/nm
    export STRIP=$tool/bin/strip
    export OBJCOPY=$tool/bin/objcopy
    export OBJDUMP=$tool/bin/objdump
    export READELF=$tool/bin/readelf
    export HOSTAR=$tool/bin/ar
    export HOSTLD=$tool/bin/ld

    ACTIVE_BUILD="KDEB_NO_SOURCE_PACKAGE=1 NO_SOURCE=1 \
        KBUILD_NO_SYNC_CONFIG=1 KCONFIG_NOTIMESTAMP=1 \
        KCONFIG_OVERWRITECONFIG=1 \
        bindeb-pkg"
fi

# ==========================================
# 3. เตรียมไฟล์ Config
# ==========================================
cp custom_config .config

# ==========================================
# 4. ฟังก์ชันตรวจสอบการทำงาน
# ==========================================
check_compiler() {
    echo "----------------------------------------------------"
    if [[ "$COMPILER" == "clang" ]]; then
        echo "[INFO] โหมดคอมไพล์: CLANG / LLVM"
        echo "[INFO] ตัวแปร CC ที่ตั้งไว้: $CC"
        if command -v $CC &> /dev/null; then
            echo "[INFO] เวอร์ชันที่ใช้: $($CC --version | head -n 1)"
        else
            echo "[ERROR] ไม่พบคำสั่ง $CC ในระบบ! โปรดติดตั้ง llvm และ clang"
            exit 1
        fi
    else
        echo "[INFO] โหมดคอมไพล์: GCC"
        echo "[INFO] ตัวแปร CC ที่ตั้งไว้: $CC"
        if command -v $CC &> /dev/null; then
            echo "[INFO] เวอร์ชันที่ใช้: $($CC --version | head -n 1)"
        else
            echo "[ERROR] ไม่พบคำสั่ง $CC ในระบบ! โปรดตรวจสอบพาธ"
            exit 1
        fi
    fi
    echo "----------------------------------------------------"
}

# ==========================================
# 5. เริ่มกระบวนการ Build
# ==========================================
check_compiler

# สร้าง Modules ก่อน
make -j$(nproc) modules

# สร้างแพ็กเกจ .deb และติดตั้ง Modules พร้อม Strip
make -j$(nproc) $ACTIVE_BUILD INSTALL_MOD_STRIP=1

echo "[✅] เสร็จสิ้นกระบวนการทำงาน!"