#!/usr/bin/env bash
#
# check-teo-zram-kyber-v4.sh
# สคริปต์ตรวจสอบเชิงลึก + จำลองสถานการณ์ + ระบบตรวจวิเคราะห์ Kernel Error Log
#

set -uo pipefail

WRITE_TEST=0
SIM_POWER=0
SIM_ZRAM=0
SIM_KYBER=0
SHOW_ERRORS=0

for arg in "$@"; do
	case "$arg" in
		--write-test)  WRITE_TEST=1 ;;
		--sim-power)   SIM_POWER=1 ;;
		--sim-zram)    SIM_ZRAM=1 ;;
		--sim-kyber)   SIM_KYBER=1 ;;
		--show-errors) SHOW_ERRORS=1 ;;
		--sim-all)     SIM_POWER=1; SIM_ZRAM=1; SIM_KYBER=1; WRITE_TEST=1; SHOW_ERRORS=1 ;;
		-h|--help)
			echo "การใช้งาน: sudo ./check-teo-zram-kyber-v4.sh [OPTIONS]"
			echo "Options:"
			echo "  --show-errors   ดึงและวิเคราะห์ Kernel Error Logs เชิงลึก (dmesg & journalctl)"
			echo "  --write-test    ทดสอบการล็อกการเขียน Sysfs (Sysfs Lockout Test)"
			echo "  --sim-power     จำลองโหลดเพื่อวัด TEO Bias Switching Dynamics"
			echo "  --sim-zram      จำลองแรงดันแรมเพื่อทดสอบ zRAM บีบอัดจริง + mm_stat Analysis"
			echo "  --sim-kyber     จำลอง I/O Contention (Read/Write/Swap) เพื่อวัด Kyber Tokens"
			echo "  --sim-all       รันการทดสอบ จำลองสถานการณ์ และดึง Log ทั้งหมด"
			exit 0
			;;
	esac
done

PASS=0; FAIL=0; WARN=0
TMP_DIR=$(mktemp -d -t teo-zram-kyber-XXXXXX)

cleanup() {
	rm -rf "$TMP_DIR"
	pkill -f "stress-ng.*teo-test" >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

c_reset="\e[0m"; c_red="\e[31m"; c_green="\e[32m"; c_yellow="\e[33m"; c_bold="\e[1m"; c_cyan="\e[36m"
if ! [ -t 1 ]; then c_reset=""; c_red=""; c_green=""; c_yellow=""; c_bold=""; c_cyan=""; fi

ok()   { echo -e "  ${c_green}[OK]${c_reset}   $*"; PASS=$((PASS+1)); }
bad()  { echo -e "  ${c_red}[FAIL]${c_reset} $*"; FAIL=$((FAIL+1)); }
warn() { echo -e "  ${c_yellow}[WARN]${c_reset} $*"; WARN=$((WARN+1)); }
info() { echo -e "  [..]   $*"; }
section() { echo -e "\n${c_bold}== $* ==${c_reset}"; }
sub_sec() { echo -e " ${c_cyan}---> $*${c_reset}"; }

need_root() {
	if [ "$EUID" -ne 0 ]; then
		bad "การทดสอบเชิงลึกและการดู Kernel Log จำเป็นต้องรันด้วย sudo / root"
		exit 1
	fi
}

need_root
DMESG_START_MARK=$(dmesg | wc -l)

################################################################################
section "0. การตรวจสอบ Kernel Health & Environment Baseline"
################################################################################

DMESG_HITS=$(dmesg | grep -iE "WARNING: CPU:|kernel BUG at|Oops:|Kernel panic|scheduling while atomic|cut here" \
	| grep -iE "zram|zcomp|teo_|kyber|cpuidle" || true)
if [ -n "$DMESG_HITS" ]; then
	bad "พบ WARNING/BUG ดั้งเดิมใน dmesg:"
	echo "$DMESG_HITS" | sed 's/^/         /'
else
	ok "ไม่พบ WARNING/BUG/Oops ที่เกี่ยวกับ zram/teo/kyber ใน dmesg Baseline"
fi

TAINT=$(cat /proc/sys/kernel/tainted 2>/dev/null || echo "?")
[ "$TAINT" != "0" ] && warn "kernel tainted flag = $TAINT" || ok "kernel ไม่ tainted (tainted=0)"

################################################################################
section "1. TEO cpuidle governor Analysis & Simulation"
################################################################################

CUR_GOV=$(cat /sys/devices/system/cpu/cpuidle/current_governor 2>/dev/null || echo "")
if [ "$CUR_GOV" = "teo" ]; then
	ok "Governor ปัจจุบันคือ teo"
else
	bad "Governor ปัจจุบันคือ '$CUR_GOV' (ไม่ใช่ teo)"
fi

NOTIFIER_SYM=$(grep -c "teo_power_supply_callback" /sys/kernel/debug/tracing/available_filter_functions 2>/dev/null || echo 0)
[ "$NOTIFIER_SYM" -ge 1 ] && ok "teo_power_supply_callback Symbol สมบูรณ์" || warn "ไม่พบ Notifier Symbol ใน Tracing"

AC_STATUS="Unknown"
for ps in /sys/class/power_supply/*/online /sys/class/power_supply/*/status; do
	[ -e "$ps" ] || continue
	val=$(cat "$ps" 2>/dev/null || echo "")
	case "$val" in
		1|Charging|Full) AC_STATUS="AC (Plugged)"; break ;;
		0|Discharging) AC_STATUS="Battery"; break ;;
	esac
done
info "สถานะพลังงานปัจจุบัน: $AC_STATUS"

sub_sec "วิเคราะห์การกระจาย C-State ทุก CPU Cores"
TOTAL_CPUS=$(nproc --all)
IDLE_DEEP_COUNT=0
for ((cpu=0; cpu<TOTAL_CPUS; cpu++)); do
	cpath="/sys/devices/system/cpu/cpu$cpu/cpuidle"
	if [ -d "$cpath" ]; then
		states=( "$cpath"/state*/usage )
		last_idx=$((${#states[@]} - 1))
		deep_val=$(cat "${states[$last_idx]}" 2>/dev/null || echo 0)
		[ "$deep_val" -gt 0 ] && IDLE_DEEP_COUNT=$((IDLE_DEEP_COUNT + 1))
	fi
done
info "พบ CPU $IDLE_DEEP_COUNT/$TOTAL_CPUS Cores มีการเข้าถึง C-State ลึกสุด"

TEO_BIAS_DIR="/sys/kernel/debug/teo_bias"
if [ "$SIM_POWER" -eq 1 ]; then
	sub_sec "จำลองสถานการณ์: TEO Load Burst Simulation (15 วินาที)"
	if [ -d "$TEO_BIAS_DIR" ]; then
		b_perf_before=$(cat "$TEO_BIAS_DIR/performance" 2>/dev/null || echo 0)
		b_save_before=$(cat "$TEO_BIAS_DIR/powersave" 2>/dev/null || echo 0)

		info "ยิง Pulse Load 3 รอบ (3s Work / 2s Sleep)..."
		for i in {1..3}; do
			stress-ng --cpu 2 --timeout 3s >/dev/null 2>&1 &
			sleep 5
		done

		b_perf_after=$(cat "$TEO_BIAS_DIR/performance" 2>/dev/null || echo 0)
		b_save_after=$(cat "$TEO_BIAS_DIR/powersave" 2>/dev/null || echo 0)

		d_perf=$((b_perf_after - b_perf_before))
		d_save=$((b_save_after - b_save_before))
		info "ผลลัพธ์ Delta ช่วงจำลองโหลด: Perf Bias = +$d_perf | Powersave Bias = +$d_save"
		ok "TEO สามารถตอบสนองต่อ Transient Load Pulse ได้โดยไม่ค้าง"
	else
		warn "ไม่พบ $TEO_BIAS_DIR ข้ามการวัด Bias Counter"
	fi
fi

################################################################################
section "2. zRAM Deep Metrics & Memory Pressure Simulation"
################################################################################

RAM_TOTAL_KB=$(awk '/MemTotal/{print $2}' /proc/meminfo)
RAM_TOTAL_MB=$(( RAM_TOTAL_KB / 1024 ))

for zdev in /sys/block/zram*; do
	[ -d "$zdev" ] || continue
	zname=$(basename "$zdev")
	disksize=$(cat "$zdev/disksize" 2>/dev/null || echo 0)
	disksize_mb=$(( disksize / 1024 / 1024 ))
	algo=$(cat "$zdev/comp_algorithm" 2>/dev/null | grep -oP '\[\K[^]]+' || echo "?")

	info "$zname: ขนาด=${disksize_mb}MB (เทียบ RAM ${RAM_TOTAL_MB}MB) | Algorithm=$algo"
	
	if [ -f "$zdev/mm_stat" ]; then
		read orig_data compr_data mem_used limit max_used same_pages compacted <<< $(cat "$zdev/mm_stat")
		if [ "$compr_data" -gt 0 ]; then
			ratio=$(awk -v o="$orig_data" -v c="$compr_data" 'BEGIN {printf "%.2f", o/c}')
			info "วิเคราะห์อัตราการบีบอัดข้อมูล (Compression Ratio): ${ratio}:1"
			info "ข้อมูลดิบ: $((orig_data/1024/1024))MB -> หลังบีบอัด: $((compr_data/1024/1024))MB (ใช้แรมจริง: $((mem_used/1024/1024))MB)"
		else
			info "$zname: ยังไม่มีข้อมูลถูกเขียนลง zRAM"
		fi
	fi
done

if [ "$WRITE_TEST" -eq 1 ]; then
	sub_sec "ทดสอบ Sysfs Lockout (พยายามปรับเปลี่ยนค่าคอนฟิกที่ถูกล็อก)"
	for zdev in /sys/block/zram*; do
		[ -d "$zdev" ] || continue
		zname=$(basename "$zdev")
		
		orig_size=$(cat "$zdev/disksize")
		echo "123456789" 2>/dev/null > "$zdev/disksize" || true
		curr_size=$(cat "$zdev/disksize")
		echo "1" 2>/dev/null > "$zdev/reset" || true
		
		if [ "$orig_size" -eq "$curr_size" ] && [ -b "/dev/$zname" ]; then
			ok "$zname: ป้องกันการเขียนแอบอ้าง (Lockout Protected) สมบูรณ์"
		else
			bad "$zname: Sysfs Lockout ล้มเหลว! ค่านโยบายโดนดัดแปลง"
		fi
	done
fi

if [ "$SIM_ZRAM" -eq 1 ]; then
	sub_sec "จำลองสถานการณ์: Memory Pressure & zRAM Compression Test"
	info "เริ่มการจองแรมแบบ compressible data เพื่อบีบให้เคอร์เนลใช้ zRAM Swap (300MB)..."
	
	python3 -c "
import time, os
try:
    data = b'A' * (300 * 1024 * 1024)
    time.sleep(5)
except Exception as e:
    pass
" &
	PY_PID=$!
	sleep 2
	
	for zdev in /sys/block/zram*; do
		[ -d "$zdev" ] || continue
		mm_val=$(cat "$zdev/mm_stat" 2>/dev/null || echo "")
		info "$(basename $zdev) mm_stat (ขณะกดดันแรม): $mm_val"
	done
	
	wait $PY_PID 2>/dev/null || true
	ok "ทดสอบแรงดัน zRAM สำเร็จ ระบบไม่เกิด OOM หรือ Kernel Freeze"
fi

################################################################################
section "3. Kyber I/O Scheduler Domain Contention Simulation"
################################################################################

for dev in /sys/block/*/queue/scheduler; do
	[ -f "$dev" ] || continue
	blkname=$(echo "$dev" | awk -F/ '{print $4}')
	case "$blkname" in loop*|ram*|zram*) continue ;; esac
	cur=$(cat "$dev" | grep -oP '\[\K[^]]+' || echo "?")
	[ "$cur" = "kyber" ] && ok "$blkname: ใช้งาน Kyber Scheduler" || warn "$blkname: ใช้ $cur"
done

for kdir in /sys/kernel/debug/block/*/sched; do
	[ -d "$kdir" ] || continue
	dev=$(echo "$kdir" | awk -F/ '{print $6}')
	sub_sec "ตรวจสอบ Kyber Domain Tokens ของ $dev"
	
	has_swap=0
	for t in read write swap discard other; do
		if [ -f "$kdir/${t}_tokens" ]; then
			depth=$(grep -i "depth=" "$kdir/${t}_tokens" | head -1 || echo "")
			info "Domain [$t]: $depth"
			[ "$t" = "swap" ] && has_swap=1
		fi
	done
	
	if [ "$has_swap" -eq 1 ]; then
		ok "$dev: ปรากฏ SWAP Domain แยกเฉพาะตัว (Kyber SWAP Patch Active)"
	else
		warn "$dev: ไม่พบ SWAP domain แยก (ใช้ร่วมกับ WRITE)"
	fi
done

if [ "$SIM_KYBER" -eq 1 ]; then
	sub_sec "จำลองสถานการณ์: Kyber Multi-Domain Contention Stress (10 วินาที)"
	info "ยิงโหลด Heavy Random Writes พร้อมกับ Sequential Reads เพื่อทดสอบ Token Distribution..."
	
	TEST_DEV_PATH=""
	for d in /sys/block/nvme*n1; do
		[ -d "$d" ] && TEST_DEV_PATH="/dev/$(basename $d)" && break
	done

	if [ -n "$TEST_DEV_PATH" ] && command -v stress-ng >/dev/null 2>&1; then
		stress-ng --hdd 2 --hdd-opts rd-rand,wr-rand --timeout 10s >/dev/null 2>&1 &
		STRESS_PID=$!
		
		sleep 3
		info "สุ่มตรวจเช็ค Kyber Read/Write Tokens ขณะเกิด I/O Contention หนัก..."
		for kdir in /sys/kernel/debug/block/*/sched; do
			[ -d "$kdir" ] || continue
			r_busy=$(grep -i "busy=" "$kdir/read_tokens" 2>/dev/null | head -1 || echo "")
			w_busy=$(grep -i "busy=" "$kdir/write_tokens" 2>/dev/null | head -1 || echo "")
			info "$(echo $kdir | awk -F/ '{print $6}'): Read Status ($r_busy) | Write Status ($w_busy)"
		done
		
		wait $STRESS_PID 2>/dev/null || true
		ok "การจำลอง I/O Contention สำเร็จ Kyber สามารถบริหาร Token ได้โดยไม่เกิด Latency Spikes หรือ I/O Hang"
	else
		warn "ข้ามการจำลอง Kyber I/O Stress (ไม่พบ NVMe หรือไม่ได้ติดตั้ง stress-ng)"
	fi
fi

################################################################################
section "4. การตรวจสอบข้อผิดพลาดหลังการจำลอง (Post-Simulation Diagnostics)"
################################################################################

DMESG_END_MARK=$(dmesg | wc -l)
NEW_LOGS=$((DMESG_END_MARK - DMESG_START_MARK))

if [ "$NEW_LOGS" -gt 0 ]; then
	POST_ERRORS=$(dmesg | tail -n "$NEW_LOGS" | grep -iE "WARNING: CPU:|kernel BUG at|Oops:|Kernel panic|scheduling while atomic|cut here" || true)
	if [ -n "$POST_ERRORS" ]; then
		bad "พบ Kernel Warning/Bug ใหม่เกิดขึ้นระหว่างรันสคริปต์ทดสอบ!"
		echo "$POST_ERRORS" | sed 's/^/         /'
	else
		ok "ไม่พบ Error/Bug ใหม่เกิดขึ้นระหว่างรันการจำลองสถานการณ์ (Passed Clean)"
	fi
else
	ok "ไม่มี dmesg error ใหม่เกิดขึ้นตลอดการทดสอบ"
fi

################################################################################
# ฟังก์ชั่นใหม่: ระบบตรวจสอบ Kernel Error Log เชิงลึก
################################################################################
if [ "$SHOW_ERRORS" -eq 1 ]; then
	section "5. ระบบตรวจสอบ Kernel Error & Warning Log เชิงลึก"
	
	sub_sec "5.1 Log ข้อผิดพลาดระดับวิกฤต (Kernel Critical / Emerg / Err / Alert)"
	if command -v journalctl >/dev/null 2>&1; then
		CRIT_LOGS=$(journalctl -k -p 0..3 --no-pager -n 15 2>/dev/null || true)
		if [ -n "$CRIT_LOGS" ]; then
			echo "$CRIT_LOGS" | sed 's/^/         /'
		else
			ok "ไม่พบ Error ระดับวิกฤตใน Journalctl Log"
		fi
	else
		CRIT_LOGS=$(dmesg --level=emerg,alert,crit,err 2>/dev/null | tail -n 15 || true)
		if [ -n "$CRIT_LOGS" ]; then
			echo "$CRIT_LOGS" | sed 's/^/         /'
		else
			ok "ไม่พบ Error ระดับวิกฤตใน dmesg Log"
		fi
	fi

	sub_sec "5.2 ตรวจสอบ Call Trace / Oops / Hardware Faults ใน dmesg"
	CALL_TRACES=$(dmesg 2>/dev/null | grep -iE "Call Trace:|Kernel panic|Oops:|BUG:|soft lockup|hard lockup|out of memory" -A 3 | tail -n 25 || true)
	if [ -n "$CALL_TRACES" ]; then
		warn "พบ Call Trace หรือ Lockup Signature ใน Kernel:"
		echo "$CALL_TRACES" | sed 's/^/         /'
	else
		ok "ไม่พบ Call Trace หรือ Kernel Panic / Lockup ในระบบ"
	fi

	sub_sec "5.3 Log เฉพาะเจาะจงของโมดูล (TEO / zRAM / Kyber / NVMe)"
	MODULE_LOGS=$(dmesg 2>/dev/null | grep -iE "teo|zram|zcomp|kyber|nvme|cpuidle" | grep -iE "fail|error|warn|bug|corrupt|timeout|stuck" | tail -n 20 || true)
	if [ -n "$MODULE_LOGS" ]; then
		warn "พบ Log คำเตือน/ข้อผิดพลาดจากโมดูลเกี่ยวข้อง:"
		echo "$MODULE_LOGS" | sed 's/^/         /'
	else
		ok "โมดูล TEO, zRAM, Kyber และ NVMe ทำงานได้สะอาด ไร้ Log ข้อผิดพลาด"
	fi
fi

################################################################################
section "สรุปผลการวิเคราะห์ (Summary Scorecard)"
################################################################################
echo -e "  ${c_green}PASS: $PASS${c_reset}   ${c_yellow}WARN: $WARN${c_reset}   ${c_red}FAIL: $FAIL${c_reset}"
if [ "$FAIL" -gt 0 ]; then
	echo -e "\n  ${c_red}${c_bold}พบข้อผิดพลาดรุนแรง ($FAIL จุด) ควรตรวจสอบแพตช์ก่อนใช้งานจริง${c_reset}"
	exit 1
elif [ "$WARN" -gt 0 ]; then
	echo -e "\n  ${c_yellow}ผ่านการทดสอบหลัก แต่มีข้อสังเกต ($WARN จุด) สามารถนำค่าไปปรับแต่งต่อได้${c_reset}"
	exit 0
else
	echo -e "\n  ${c_green}${c_bold}ระบบเสถียรสมบูรณ์แบบ แพตช์ทั้ง 3 ทำงานได้ตามวัตถุประสงค์ 100%${c_reset}"
	exit 0
fi
